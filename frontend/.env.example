# Frontend — required for API calls (must include /api/v1, no trailing slash)
# On EC2 with nginx: http://YOUR_EC2_PUBLIC_IP/api/v1
# After domain:     https://yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://YOUR_EC2_PUBLIC_IP/api/v1

# Public site origin for SEO (canonical, sitemap, Open Graph). No trailing slash.
# On EC2 testing: http://YOUR_EC2_PUBLIC_IP
# After domain:   https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://YOUR_EC2_PUBLIC_IP
