# Server
PORT=4000
NODE_ENV=development
# Comma-separated origins (local + Vercel production / preview)
CORS_ORIGIN=http://localhost:3000,https://YOUR-VERCEL-APP.vercel.app
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Shared base32 secret for seeded demo staff (Authenticator app / tests; ≥128-bit)
DEMO_TOTP_SECRET=BTRSABHTAOR7A2U4DZLNIQI6H5OZSNDT

# Postgres — use kudligi_mla database (not default postgres)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_RDS_HOST:5432/kudligi_mla?schema=public&sslmode=require
# Used only by scripts/createDatabase.js to create the DB
ADMIN_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_RDS_HOST:5432/postgres

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=kudligi-mla

# WhatsApp Cloud API (Meta) — optional until bot is enabled
# See backend/docs/WHATSAPP_SETUP.md
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=kudligi-wa-verify-change-me
WHATSAPP_API_VERSION=v21.0
# Optional template names (after Meta approval)
WHATSAPP_TEMPLATE_REPLY_KN=complaint_reply_kn
WHATSAPP_TEMPLATE_REPLY_EN=complaint_reply_en
WHATSAPP_TEMPLATE_REGISTERED_KN=complaint_registered_kn
WHATSAPP_TEMPLATE_REGISTERED_EN=complaint_registered_en
